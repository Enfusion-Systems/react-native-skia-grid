{
  "name": "react-native-skia-grid",
  "version": "0.1.0",
  "description": "High-performance Skia-based data grid for React Native",
  "license": "MIT",
  "private": false,
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js",
      "types": "./lib/typescript/src/index.d.ts"
    },
    "./themes": {
      "import": "./lib/module/themes/index.js",
      "require": "./lib/commonjs/themes/index.js",
      "types": "./lib/typescript/src/themes/index.d.ts"
    }
  },
  "scripts": {
    "build": "bob build",
    "clean": "del-cli lib",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "release": "release-it"
  },
  "dependencies": {
    "lodash": "^4.17.21",
    "date-fns": "^2.16.1",
    "uuid": "^8.3.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-native": "^0.72.0 || ^0.73.0 || ^0.74.0 || ^0.75.0 || ^0.76.0 || ^0.77.0 || ^0.78.0 || ^0.79.0",
    "@shopify/react-native-skia": "^1.0.0 || ^2.0.0",
    "react-native-gesture-handler": "^2.12.0",
    "react-native-reanimated": "^3.3.0",
    "react-native-svg": "^13.0.0 || ^14.0.0 || ^15.0.0",
    "react-native-safe-area-context": "^4.0.0 || ^5.0.0",
    "@react-navigation/native-stack": "^6.0.0 || ^7.0.0",
    "@fortawesome/fontawesome-svg-core": "^6.0.0",
    "@fortawesome/pro-solid-svg-icons": "^6.0.0",
    "@fortawesome/react-native-fontawesome": "^0.3.0",
    "@gorhom/bottom-sheet": "^5.0.0",
    "@fortawesome/free-solid-svg-icons": "^6.0.0",
    "@hookform/error-message": "^2.0.0",
    "react-hook-form": "^6.0.0 || ^7.0.0",
    "emoji-regex": "^10.0.0",
    "react-native-draggable-flatlist": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-safe-area-context": {
      "optional": true
    },
    "@hookform/error-message": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    },
    "emoji-regex": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^9.1.2",
    "@release-it/conventional-changelog": "^5.0.0",
    "@types/jest": "^29.5.5",
    "@types/lodash": "^4.17.0",
    "@types/react": "~19.0.0",
    "@types/uuid": "^8.3.0",
    "commitlint": "^9.1.2",
    "del-cli": "^5.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "lefthook": "^1.5.0",
    "prettier": "^2.4.1",
    "react-native-builder-bob": "^0.23.2",
    "release-it": "^15.0.0",
    "typescript": "^5.3.0"
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": ["@commitlint/config-conventional"]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      ["typescript", { "project": "tsconfig.build.json" }]
    ]
  }
}
