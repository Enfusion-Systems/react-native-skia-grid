# Library build output (react-native-builder-bob)
# Anchored to repo root so it does not also ignore nested source dirs
# named "lib" (e.g. src/view/columnActions/filter/lib).
/lib/

# Dependencies
node_modules/

# Caches
.turbo/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/

# Logs
*.log
npm-debug.log*
yarn-error.log*
yarn-debug.log*

# Detox artifacts (suite-level)
.artifacts/

# Benchmark run output (baselines/ are committed; reports/ are per-run)
/benchmarks/reports/

# Visual-snapshot diff output (baselines under __image_snapshots__ are committed)
example/e2e/__image_snapshots__/**/__diff_output__/

# Coverage
/coverage

docs/
