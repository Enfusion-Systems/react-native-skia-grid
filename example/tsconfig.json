{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-native",
    "strict": true,
    "noEmit": true,
    "paths": {
      "react-native-skia-grid": ["../src"],
      "react-native-skia-grid/*": ["../src/*"]
    }
